<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- COM 加载项只能用 .NET Framework，禁止 .NET 8/9 -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BetterWPP</AssemblyName>
    <RootNamespace>BetterWPP</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 版本必须为整数，用于 CI 归档命名 PPTAgent+{version}+{YYMMDD}+{HHMMSS} -->
    <Version>110</Version>
    <FileVersion>110.0.0.0</FileVersion>
    <!-- 强名称签名：需要时把 pfx 放到 src\sign\ 并打开下一行 -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- NetOffice：NuGet 拉取，CI/本机都不依赖本机安装的 PowerPoint PIA；运行时才需本机有 Office -->
    <PackageReference Include="NetOfficeFw.PowerPoint" Version="1.9.12" />
    <!-- IDTExtensibility2 / ext_ConnectMode / ext_DisconnectMode 所在互操作程序集（VS SDK NuGet，CI 无需本机装 Office/VS） -->
    <PackageReference Include="Microsoft.VisualStudio.Interop" Version="17.14.40260" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ribbon XML 作为内嵌资源，供 CustomUI 特性 / GetCustomUI 读取 -->
    <EmbeddedResource Include="RibbonUI.xml" />
  </ItemGroup>

</Project>
